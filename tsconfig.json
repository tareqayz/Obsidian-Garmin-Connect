{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"allowSyntheticDefaultImports": true,
		"useUnknownInCatchVariables": true,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2020"
		],
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"scripts/**/*.ts",
		"tests/**/*.ts"
	]
}
