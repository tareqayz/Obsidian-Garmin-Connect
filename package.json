{
	"name": "obsidian-garmin-connect",
	"version": "0.0.1",
	"description": "Phase 0 probe: can Obsidian talk to Garmin SSO on desktop and mobile?",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && npm run test && node esbuild.config.mjs production && node scripts/check-mobile-safe.mjs",
		"check": "node scripts/check-mobile-safe.mjs",
		"probe:node": "esbuild scripts/node-probe.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.node-probe.mjs --log-level=warning && node scripts/.node-probe.mjs",
		"test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --target=node20 --outdir=tests/.build --out-extension:.js=.mjs --log-level=warning && node --test tests/.build"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.5",
		"obsidian": "^1.10.0",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3"
	}
}
