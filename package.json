{
	"name": "obsidian-garmin-connect",
	"version": "1.2.0",
	"description": "Sync your Garmin Connect health and activity data into your vault and browse it in Garmin-style Home, Activities, Sleep and Health Stats pages.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && npm run svelte-check && npm run test && node esbuild.config.mjs production && node scripts/check-mobile-safe.mjs",
		"check": "node scripts/check-mobile-safe.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"api:extract": "python3 scripts/api/extract-endpoints.py",
		"api:extract:check": "python3 scripts/api/extract-endpoints.py --check",
		"api:check": "esbuild scripts/api/contract-check.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.api-check.mjs --log-level=warning && node scripts/.api-check.mjs",
		"api:record": "npm run api:check -- --update",
		"api:ramp": "esbuild scripts/api/ramp.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.api-ramp.mjs --log-level=warning && node scripts/.api-ramp.mjs",
		"api:ramp:eval": "esbuild scripts/api/ramp-eval.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=scripts/.api-ramp-eval.js --log-level=warning",
		"api:token": "esbuild scripts/api/mint-token.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.api-token.mjs --log-level=warning && node scripts/.api-token.mjs",
		"pretest": "node -e \"require('node:fs').rmSync('tests/.build',{recursive:true,force:true})\"",
		"test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --target=node20 --alias:obsidian=./tests/support/obsidian.ts --outdir=tests/.build --out-extension:.js=.mjs --log-level=warning && node --test \"tests/.build/*.mjs\"",
		"iphone:build": "zsh scripts/iphone/build.sh",
		"release:notes": "esbuild scripts/release/notes.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.release-notes.mjs --log-level=warning && node scripts/.release-notes.mjs",
		"release:beta": "esbuild scripts/release/beta.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.release-beta.mjs --log-level=warning && node scripts/.release-beta.mjs",
		"api:record-file": "esbuild scripts/api/record-from-file.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.api-record-file.mjs --log-level=warning && node scripts/.api-record-file.mjs",
		"svelte-check": "svelte-check --tsconfig src/tsconfig.json",
		"lint": "eslint ."
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.5",
		"esbuild-svelte": "^0.9.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"leaflet": "1.9.4",
		"obsidian": "^1.13.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.71.2"
	}
}
